{
  "name": "raintoday",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"lib/**/*.test.ts\" && tsx --test components/local/LocalForecastExperience.test.tsx",
    "performance:capture": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/local-performance.ts",
    "location:matrix": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/location-matrix.ts",
    "service:health": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/service-health.ts",
    "service-area:generate": "node scripts/generate-service-area.ts",
    "performance:seed": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed-backfill.ts",
    "performance:observations": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/backfill-observations.ts",
    "performance:catalog": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/generate-station-catalog.ts"
  },
  "dependencies": {
    "next": "16.3.4",
    "postgres": "^3.4.9",
