{
  "name": "raintoday",
  "version": "2.5.7",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:lib && npm run test:ui && npm run test:routes",
    "test:lib": "node --test \"lib/**/*.test.ts\"",
    "test:ui": "tsx --test components/local/LocalForecastExperience.test.tsx",
    "test:routes": "tsx --test \"app/api/**/*.test.ts\"",
    "verify": "npm run lint && npm run typecheck && npm run test:dependency-compatibility && npm test && npm run build",
    "performance:capture": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/local-performance.ts",
    "location:matrix": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/location-matrix.ts",
    "service:health": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/service-health.ts",
    "service-area:generate": "node scripts/generate-service-area.ts",
    "performance:seed": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed-backfill.ts",
    "performance:observations": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/backfill-observations.ts",
    "performance:hourly-amounts": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/hourly-amount-report.ts",
    "performance:catalog": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/generate-station-catalog.ts",
    "test:browser": "playwright test",
    "audit:dependencies": "node scripts/dependency-audit.ts",
    "test:dependency-audit": "node --test scripts/dependency-audit.test.ts",
    "test:dependency-compatibility": "node --test scripts/dependency-compatibility.test.ts"
  },
  "dependencies": {
    "@sentry/browser": "^11.10.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.4.5",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "fast-check": "4.10.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.4"
  }
}
