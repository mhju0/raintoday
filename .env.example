# ════════════════════════════════════════════════════════════════
# 오늘비 환경 변수.
#
# 핵심 예보 화면은 키가 하나도 없어도 완전히 동작합니다: Open-Meteo(예보)는 키 불필요.
# 지역 직접 검색과 현재 위치 지명 표시에는 KAKAO_REST_API_KEY가 필요합니다. 나머지 키는 보강
# (enrichment)용이며, 없거나 실패하면 해당 기능만 우아하게 강등됩니다.
#
# 사용법:  install -m 600 .env.example .env.local  →  값 입력  →  dev 서버 재시작
# 모든 키는 서버 전용이며, NEXT_PUBLIC_ 접두어가 없는 한 클라이언트에
# 노출되지 않습니다(현재 NEXT_PUBLIC_ 변수는 없음).
# ════════════════════════════════════════════════════════════════


# ─── 대한민국 행정구역 검색 (지역 직접 찾기에 필요) ───

# Kakao Map Local REST API 키. 서버에서만 사용되며 클라이언트에 노출되지 않습니다.
# 미설정 시 브라우저 현재 위치는 계속 동작하지만, 지명 대신 '현재 위치'로만 표시되고
# 지역 직접 검색은 search_not_configured로 비활성화됩니다(재시도 버튼을 띄우지 않음).
#   (read: lib/locationSearch.ts)
KAKAO_REST_API_KEY=


# ─── 예보 소스 (교차 검증 · Open-Meteo가 키 불필요 기본 워크호스) ───

# 기상청 단기예보 (data.go.kr 활용신청). Encoding/Decoding 키 어느 쪽이든 동작.
#   미설정 → KMA 예보/관측 보강 생략.  (read: lib/providers/kma.ts)
KMA_SHORT_TERM_API_KEY=

# Pirate Weather (pirateweather.net 무료 키). 미설정 → 해당 소스 생략.
#   월 10,000회 상한이 이 프로젝트에서 유일하게 도달 가능한 상한입니다.
#   `npm run service:health`가 남은 할당량과 파이프라인 소진 속도를 함께 점검합니다.
#   (read: lib/providers/pirate-weather.ts)
PIRATE_WEATHER_API_KEY=

# WeatherAPI.com (weatherapi.com 무료 키). 미설정 → 해당 소스 생략.
#   (read: lib/providers/weather-api.ts)
WEATHERAPI_KEY=

# Visual Crossing Timeline (visualcrossing.com 무료 키). 미설정 → 해당 소스 생략.
#   예보 1회 호출 = 1 record(15일 시간별 응답도 동일, 실측 확인). 무료 1,000 record/일에
#   대해 파이프라인 194회/일은 여유가 있습니다. 다만 응답에 잔여 할당량 헤더가 없어
#   Pirate Weather처럼 남은 양을 미리 볼 수 없고, 소진은 429로만 드러납니다.
#   (read: lib/providers/visual-crossing.ts)
VISUAL_CROSSING_API_KEY=


# ─── 전국 지역별 강수 성능 (PostgreSQL · 선택) ───

# 06시/18시 KST 고정 코호트의 익일 예보와 ASOS 관측을 저장하는 표준 PostgreSQL URL.
# 미설정 시 예보는 그대로 동작하며 지역별 최근 성능 보강만 비활성화됩니다.
# 사용자 위치는 이 DB에 저장하지 않고, 공식 관측소·예보 캡처·관측값만 저장합니다.
# 예약 작업: .github/workflows/local-performance.yml.
PERFORMANCE_DATABASE_URL=

# 지상 관측 진실값 키: 기상청 지상(ASOS) 일자료 조회서비스(data.go.kr
#   AsosDalyInfoService) — 단기예보 키와는 별도 구독. 미설정 시 KMA_SHORT_TERM_API_KEY로
#   폴백하나, 그 키가 ASOS 미구독이면 403 → 해당 일자 채점 건너뜀(값 지어내지 않음).
#   cron/스크립트 전용.  (read: lib/performance/kma.ts)
KMA_OBSERVATION_API_KEY=

# KMA API허브 authKey (apihub.kma.go.kr). ASOS 관측소 목록(stn_inf) 조회에만 쓰입니다.
#   1.1.1 지상 활용신청이 별도로 필요하며, 미설정/불가 시 코호트는 이미 기록된 관측소
#   목록으로 강등되고 catalogSource를 "store"로 보고합니다(조용히 넘어가지 않음).
#   cron/스크립트 전용.  (read: lib/performance/kma.ts)
KMA_APIHUB_KEY=

# 저장소 어댑터 계약 테스트(lib/performance/storeContract.ts)를 PostgreSQL에도
# 돌리기 위한 "버려도 되는" 데이터베이스 URL. 미설정 시 해당 테스트는 skip으로
# 보고되고 인메모리 어댑터만 검증됩니다.
#   경고: 이 스위트는 해당 DB의 테이블을 TRUNCATE합니다. 절대 운영 URL을 넣지 마세요.
#   예: createdb raintoday_store_contract 후
#       postgres://<user>@localhost:5432/raintoday_store_contract
#   (read: lib/performance/storeContract.test.ts)
PERFORMANCE_STORE_CONTRACT_URL=
